<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="S8_P4.Pages.MainPage"
             BackgroundColor="#EAF2FB">
    <StackLayout Padding="30" Spacing="15">
        <Label Text="Calculadora de Dos Números"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="DarkBlue"
               HorizontalOptions="Center" />
        <Entry x:Name="txtNumero1"
               Placeholder="Número 1"
               FontSize="18"
               Keyboard="Numeric"
               HorizontalOptions="Fill" />
        <Entry x:Name="txtNumero2"
               Placeholder="Número 2"
               FontSize="18"
               Keyboard="Numeric"
               HorizontalOptions="Fill" />
        <Button Text="Sumar"
                Clicked="Sumar_Clicked"
                BackgroundColor="SeaGreen"
                TextColor="White"
                FontSize="18"
                HorizontalOptions="Fill" />
        <Button Text="Restar"
                Clicked="Restar_Clicked"
                BackgroundColor="OrangeRed"
                TextColor="White"
                FontSize="18"
                HorizontalOptions="Fill" />
        <Button Text="Multiplicar"
                Clicked="Multiplicar_Clicked"
                BackgroundColor="DarkOrchid"
                TextColor="White"
                FontSize="18"
                HorizontalOptions="Fill" />
        <Button Text="Dividir"
                Clicked="Dividir_Clicked"
                BackgroundColor="SteelBlue"
                TextColor="White"
                FontSize="18"
                HorizontalOptions="Fill" />
        <Label x:Name="lblResultado"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="DarkSlateGray"
               HorizontalOptions="Center" />
    </StackLayout>
</ContentPage>